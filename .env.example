# =============================================================================
# Backend — copy to backend/.env
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Acopio API
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/acopio
# Direct (non-PgBouncer) URL used by Alembic migrations. Leave empty unless you
# put PgBouncer in front of Postgres — then set both this and PGBOUNCER_MODE.
DATABASE_URL_DIRECT=
PGBOUNCER_MODE=false

# ── JWT — generate with: openssl rand -hex 32 ─────────────────────────────────
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Encryption — Fernet key for app.utils.crypto (optional) ───────────────────
# Encrypts sensitive DB-stored values.
# Falls back to SECRET_KEY when empty. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Redis — background jobs (ARQ) + cache ─────────────────────────────────────
# docker compose provides this automatically. Degrades gracefully when unset:
# no-op cache + in-process BackgroundTasks fallback.
REDIS_URL=redis://localhost:6379/0

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
# Production: set to your Vercel URL (e.g. https://acopio.vercel.app)
FRONTEND_URL=http://localhost:3000

# ── Internal API secret — generate with: openssl rand -hex 32 ────────────────
# Shared between Next.js server and FastAPI to protect /internal/* routes
INTERNAL_API_SECRET=your-internal-secret-here

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@acopio.org
MAIL_FROM_NAME=Acopio
# Svix signing secret for the Resend webhook (Resend Dashboard → Webhooks →
# your endpoint https://api.<domain>/webhooks/resend). Empty disables the
# webhook (endpoint returns 503). Enables the email deliverability/failure view.
RESEND_WEBHOOK_SECRET=

# ── IndexNow (Bing/Yandex instant indexing) ───────────────────────────────────
# Public token (NOT secret). Must equal the key file committed at
# frontend/public/<key>.txt. When set, new public campaigns ping IndexNow so
# /eventos/{slug} reaches Bing (and thus ChatGPT Search / Copilot) in minutes.
# Empty = disabled (no-op). Must be one of the values served as a key file.
INDEXNOW_KEY=

# ── Trusted proxy IPs ─────────────────────────────────────────────────────────
# Railway: use "*" — all traffic passes through Railway's load balancer
TRUSTED_PROXY_IPS=127.0.0.1

# ── Security ──────────────────────────────────────────────────────────────────
# Production: set CLOUDFLARE_ONLY=true to block requests that didn't pass through
# Cloudflare. REQUIRES CLOUDFLARE_SHARED_SECRET below — the app refuses to start
# without it, since the check is a no-op (blocks everything) otherwise.
#
# Setup (one-time, in the Cloudflare dashboard for this domain):
#   1. Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
#   2. Rules -> Transform Rules -> Modify Request Header -> Create rule
#      - When incoming requests match: hostname equals your Railway API hostname
#      - Then: Set static header "X-Origin-Auth" to the secret from step 1
#   3. Set CLOUDFLARE_SHARED_SECRET (below) to the same value in Railway.
#
# Why not just check the connecting IP against Cloudflare's ranges? On Railway
# (and similar platforms), Railway's own proxy sits between Cloudflare and the
# app — the raw TCP peer the app sees is always Railway's internal proxy, never
# Cloudflare's edge IP. That check blocks 100% of traffic unconditionally,
# including login. This shared-secret header is the fix (2026-07-02 incident).
CLOUDFLARE_ONLY=false
CLOUDFLARE_SHARED_SECRET=
ADMIN_ALLOWED_IPS=

# ── Open Food Facts — barcode lookup (public API, no key needed) ───────────────
# Timeout in seconds for barcode lookups (default 5)
OPEN_FOOD_FACTS_TIMEOUT=5.0

# ── Sentry — backend error tracking (optional) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Slack Bot — 500 alert notifications (optional) ────────────────────────────
# Create app at api.slack.com → OAuth & Permissions → Bot Token (xoxb-...)
SLACK_BOT_TOKEN=
# Canal donde aterrizan las alertas (ej. #alertas). El bot debe estar invitado.
# Vacío = las alertas no salen a ningún lado y solo quedan en el log. Vive aquí
# y no en el código porque el espacio de trabajo es de quien opera: este
# repositorio es público y quien lo forkee no debe heredar el canal de nadie.
SLACK_ALERT_CHANNEL=

# ── Google Safe Browsing — URL reputation checks (optional) ───────────────────
GOOGLE_SAFE_BROWSING_API_KEY=

# ── OAuth — Google (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =============================================================================
# Frontend — copy to frontend/.env.local
# =============================================================================

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# FastAPI URL — server-side Next.js calls (can be internal Railway URL in prod)
API_URL=http://localhost:8000
# FastAPI URL — client-side browser calls (must be public/Cloudflare-proxied in prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL — used for metadataBase, canonical tags, sitemap.xml, robots.txt
# Production: https://araguaney.lat
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal API secret (same value as backend INTERNAL_API_SECRET)
INTERNAL_API_SECRET=your-internal-secret-here

# ── OAuth — Google (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry — frontend error tracking (optional) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Google Search Console (optional) ──────────────────────────────────────────
# Setup: search.google.com/search-console -> Add property -> URL prefix
# -> https://araguaney.lat -> verification method "HTML tag" -> paste the
# content="..." value below (do NOT include the surrounding <meta> tag).
# After verifying: Sitemaps -> submit https://araguaney.lat/sitemap.xml
GOOGLE_SITE_VERIFICATION=

# ── Google Analytics 4 (optional) ─────────────────────────────────────────────
# analytics.google.com -> Admin -> Create property -> Web data stream for
# https://araguaney.lat -> copy the Measurement ID (starts with "G-").
# Only loads on public marketing pages, never /dashboard or /studio (no
# analytics on the authenticated app — see src/components/GoogleAnalytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# =============================================================================
# OPTIONAL LAYERS — see docs/optional-layers.md for full setup
# =============================================================================

# ── Cloudinary — image / video uploads ───────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── AI / OpenAI-compatible provider ──────────────────────────────────────────
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Langfuse — LLM observability ─────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Stripe — payments & subscriptions ────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=

# ── GeoIP / MaxMind — country / city lookup ──────────────────────────────────
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ── ElevenLabs — AI voice generation ─────────────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Cloudflare R2 — almacenamiento de archivos ───────────────────────────────
# Ya no es una capa opcional de una feature suelta: sin esto no funcionan los
# adjuntos de mensajería, los archivos de exportación (manifiestos, reportes) ni
# las fotos de las donaciones pre-registradas. Esas rutas responden 503 con un
# mensaje claro cuando falta, en vez de fallar a medias.
#
# La subida de fotos va directo del navegador a R2 con una URL firmada, así que
# el bucket necesita CORS que permita PUT desde el dominio del front.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Umbral de volumen atípico en donaciones (Fase 20) ────────────────────────
# A partir de cierto volumen, una donación no puede quedar anónima: el intake
# exige registrar a la persona o empresa donante, y el pre-registro en línea
# queda marcado para que el centro haga el doble check con la guía de banderas
# rojas a la mano. Es escalamiento, no tope duro: un tope invita a partir la
# donación en pedazos, que es la técnica clásica, y rechazaría al donante grande
# de buena fe justo después de una emergencia.
#
# Sin valor, el control queda apagado. Los valores operativos NO se escriben en
# este repositorio, que es público: un umbral publicado es un umbral que se puede
# rodear por diseño. Se definen en la configuración del entorno, y quien opera
# los elige según lo que sea volumen normal en su contexto.
# DONATION_VOLUME_THRESHOLD_BOXES=
# DONATION_VOLUME_THRESHOLD_KG=

# ── Plazos de conservación de datos ───────────────────────────────────────────
# Los valores por defecto son los declarados en el Aviso de Privacidad
# (/aviso-de-privacidad, sección "Plazos de conservación"). Si los cambias aquí,
# actualiza también ese documento: es una promesa publicada a las personas
# usuarias, no solo configuración.
#
# Registros de auditoría (IP, acción, fecha). Cron diario a las 3:00.
AUDIT_RETENTION_DAYS=90
# Adjuntos de mensajería. Cron diario a las 4:00.
ATTACHMENT_RETENTION_DAYS=90
# Donaciones pre-registradas que nadie confirmó por correo. Cron diario a las 5:00:
# vencen, y quien las escribió pierde su PII si no tiene otra donación viva o
# entregada. El plazo se mide desde el último correo de confirmación enviado, así
# que un reenvío compra el plazo entero. El enlace de gestión del donante dura
# 30 días (_MANAGE_TOKEN_DAYS).
DONATION_PENDING_RETENTION_DAYS=7
#
# No configurables por env (definidos en código):
#   Archivos de exportación: 1 hora, o 24 horas si la generación falló
#     (DOWNLOAD_TTL_SECONDS / FAILED_JOB_TTL_SECONDS en export_job_repository.py)
#   Fallos de envío de correo: 90 días (purge_email_failures_cron)
#   Eventos de inventario (box_event, pallet_event, shipment_event): sin purga,
#     sostienen la trazabilidad de la ayuda enviada
