  "why": {
    "heading": "Por qué Araguaney",
    "subtitle": "Decenas de centros de acopio reciben y envían suministros humanitarios de forma independiente tras sismos, inundaciones y otras emergencias. Sin un estándar común es imposible saber qué hay disponible ni preparar carga que cumpla los requisitos de envío internacional.",
    "items": [
      {
        "icon": "📦",
        "title": "Cajas homogéneas",
        "desc": "Cada caja tiene un solo tipo de producto, un lote y una caducidad. Sin mezclas. QR impreso en la etiqueta."
      },
      {
        "icon": "📋",
        "title": "Manifiesto exportable",
        "desc": "Cada envío genera un packing list con todas las cajas y tarimas, listo para trámite aduanal."
      },
      {
        "icon": "🗺️",
        "title": "Vista nacional agregada",
        "desc": "Un panel nacional muestra el stock total por categoría de todos los centros en tiempo real."
      },
      {
        "icon": "🔒",
        "title": "Sin datos personales",
        "desc": "No se almacenan datos personales de donantes ni beneficiarios. Solo inventario, trazable de la caja al envío."
      }
    ],
    "link_centro": "Ver el estándar para centros de acopio →",
    "link_ayuda": "Ver cómo funciona para cualquier emergencia →"
  },
  "standards": {
    "heading": "Estándares que respaldamos",
    "subtitle": "Araguaney está construido sobre estándares humanitarios reconocidos internacionalmente para garantizar la calidad del inventario, la trazabilidad y la compatibilidad con otros sistemas de ayuda humanitaria.",
    "items": [
      {
        "name": "WHO",
        "full": "Organización Mundial de la Salud",
        "desc": "Guías de donación de medicamentos: vida útil mínima de 12 meses, nombre INN, lote y caducidad obligatorios."
      },
      {
        "name": "IFRC / ICRC",
        "full": "Cruz Roja / Media Luna Roja",
        "desc": "Catálogo de artículos no alimentarios y códigos de material para clasificar insumos."
      },
      {
        "name": "IOM",
        "full": "Organización Internacional para las Migraciones",
        "desc": "Catálogo de artículos de asistencia de emergencia con especificaciones técnicas."
      },
      {
        "name": "UNSPSC",
        "full": "Naciones Unidas — Código de Productos y Servicios",
        "desc": "Taxonomía universal de productos para categorizar todos los tipos de insumos."
      },
      {
        "name": "GS1",
        "full": "Global Standards One",
        "desc": "Estándares de código de barras y GTIN para identificación y trazabilidad de artículos."
      }
    ]
  },
